# ==========================================
# Krishi Sahayak - Environment Configuration
# ==========================================

# Application
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Database Configuration
# Option A: Supabase (PostgreSQL - Recommended for Cloud / Render)
# Copy from Supabase Project Settings -> Database -> Connection string -> URI:
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# or Direct:
# DATABASE_URL=postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres

# Option B: Individual MySQL DB parameters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crop_advisory
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Option C: Cloud MySQL URL
# DATABASE_URL=mysql://user:password@host:port/dbname?ssl-mode=REQUIRED

# Authentication (JWT)
JWT_ACCESS_SECRET=super_secret_farmer_access_key_2026
JWT_REFRESH_SECRET=super_secret_farmer_refresh_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_METHOD=phone_otp
OTP_MODE=mock
OTP_LENGTH=6
OTP_EXPIRES_IN=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# Redis & Cache (Optional - Falls back to in-memory store if unavailable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# External Providers
WEATHER_PROVIDER=open_meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1
AI_PROVIDER=mock
STORAGE_PROVIDER=local

# WhatsApp Notifications (Optional)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
